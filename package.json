{
  "name": "xier",
  "productName": "Xier",
  "version": "1.0.0",
  "description": "Xier is a cross-platform AI conversation application based on Electron and Vue 3, allowing users to integrate multiple mainstream AI service providers for intelligent conversations, knowledge Q&A, and content generation.",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "dotenv -e .env electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "node scripts/request-release.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm test",
    "build": "vite build --config vite.renderer.config.ts",
    "site:dev": "npm --prefix site run dev --",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview --",
    "spec": "openspec",
    "spec:validate": "openspec validate --all --strict --no-interactive && openspec validate --archived --strict --no-interactive",
    "spec:gate": "node scripts/check-sdd.mjs",
    "test:workflow": "vitest run tests/spec-workflow.test.ts"
  },
  "keywords": [],
  "author": {
    "name": "xier",
    "email": "xier@foxmail.com"
  },
  "build": {
    "appId": "com.xier.noel",
    "icon": "public/noel_icon.ico"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@fission-ai/openspec": "1.15.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify/vue": "^5.0.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "dotenv-cli": "^11.0.0",
    "electron": "45.0.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@supabase/supabase-js": "^2.118.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "js-base64": "^3.9.4",
    "lucide-vue-next": "^1.0.0",
    "markdown-it-highlightjs": "^4.3.0",
    "naive-ui": "^2.45.3",
    "openai": "^7.42.0",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-markdown-render": "^2.3.1",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5"
  }
}
